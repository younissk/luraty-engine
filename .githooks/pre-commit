#!/usr/bin/env bash
# Pre-commit gate for @luraty/engine.
#
# Enable it once per clone (it is not automatic — git will not run hooks from a tracked directory
# without being told):
#
#   git config core.hooksPath .githooks
#
# WHY NATIVE, NOT HUSKY. This runs the WHOLE gate rather than doing staged-file cleverness, because
# the whole gate is fast: typecheck ~0.7s + lint ~1.5s + test ~1.1s ≈ 3.3s measured. Two of those
# three lanes cannot be narrowed to staged files anyway — `tsc --noEmit` typechecks the program, and
# a test in one file can break from an edit in another. So lint-staged would buy a fraction of one
# lane and cost a dependency plus a second idiom. husky buys the same thing plus a devDependency;
# `core.hooksPath` is what husky configures under the hood.
#
# THE BUDGET IS THE POINT. A hook that takes longer than about five seconds is a hook people start
# bypassing with --no-verify, and a bypassed gate is worth less than no gate because it still gives
# you the feeling of one. When this crosses ~5s, move `npm test` to a pre-push hook rather than
# making this smarter. Do not let it grow quietly.
#
# Escape hatch: `git commit --no-verify`. Legitimate for a WIP commit on a branch; not for main.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] typecheck..."
npm run --silent typecheck

echo "[pre-commit] lint..."
npm run --silent lint

echo "[pre-commit] test..."
npm run --silent test

echo "[pre-commit] green."
