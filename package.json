{
  "name": "@luraty/engine",
  "version": "0.5.0",
  "description": "Runtime-agnostic language-learning engine. No React, no React Native, no Expo, no database.",
  "license": "MIT",
  "author": "Youniss Kandah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luraty/engine.git"
  },
  "homepage": "https://github.com/Luraty/engine#readme",
  "bugs": {
    "url": "https://github.com/Luraty/engine/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "build": "tsdown",
    "check:publish": "npm run build && publint --strict",
    "changeset": "changeset",
    "prepare": "husky || true",
    "mutate": "stryker run",
    "coverage": "vitest run --coverage",
    "test:hermes": "node scripts/hermes.mjs",
    "demo": "node scripts/demo.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
